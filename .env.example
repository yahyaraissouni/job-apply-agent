# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=            # your own key from https://platform.claude.com (set a spend limit there)
MAIL_USER=you@example.com     # inbox that receives the verification codes (the email you apply with)
MAIL_IMAP_HOST=imap.gmail.com # imap.mail.yahoo.com, outlook.office365.com, ...
# Optional
# EASY_PROXY=socks5://127.0.0.1:1080   # route LinkedIn Easy Apply through a home connection (tunnel.sh)
# AGENT_MODEL=claude-haiku-5-5         # model that fills the forms
# AGENT_SMART_MODEL=claude-sonnet-5-5  # used only when the agent is stuck
# JOBBOT_MODEL=claude-haiku-5-5        # model that tailors the CV
